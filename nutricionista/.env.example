# ---------------------------------------------------------------
# Banco de dados
# Sem DATABASE_URL, o sistema usa um PostgreSQL embutido (PGlite)
# gravado em ~/.consultorio-nutri/pglite — ideal para testar no computador.
# Em produção, use um PostgreSQL de verdade:
# DATABASE_URL=postgres://usuario:senha@host:5432/nutri
# ---------------------------------------------------------------
DATABASE_URL=

# Endereço público do site (usado em links de e-mail e na política de cookies)
APP_URL=http://localhost:3000

# Pasta privada para arquivos enviados (documentos, fotos de refeições).
# Padrão em desenvolvimento: ~/.consultorio-nutri/uploads
UPLOAD_DIR=

# ---------------------------------------------------------------
# Integrações opcionais. Enquanto vazias, o sistema mostra a
# integração como "não configurada" e nada é enviado de verdade.
# ---------------------------------------------------------------
# E-mail transacional via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Consultório <nao-responda@seudominio.com.br>"

# Segredo exigido pela rota de tarefas agendadas (/api/cron)
CRON_SECRET=

# Apenas para o comando de dados fictícios em produção (não recomendado)
ALLOW_DEMO_SEED=
